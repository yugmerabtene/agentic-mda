        "descriptions": [
          {
            "lang": "en",
            "value": "Postfix on Mac OS X 10.3.x through 10.3.5, with SMTPD AUTH enabled, does not properly clear the username between authentication attempts, which allows users with the longest username to prevent other valid users from being able to authenticate."
          }
        ],
