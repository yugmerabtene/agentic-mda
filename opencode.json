{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": ["AGENTS.md", "CONTEXT.md"],
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/opencode/**": "allow"
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "ls": "allow",
      "pwd": "allow",
      "tree *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "env": "allow",
      "printenv *": "allow",
      "date *": "allow",
      "sha256sum *": "allow",
      "sha1sum *": "allow",
      "md5sum *": "allow",
      "diff *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "touch *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "id": "allow",
      "whoami": "allow",
      "uname *": "allow",
      "ps *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "chmod +x *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pip *": "allow",
      "pip3 *": "allow",
      "pytest *": "allow",
      "pytest": "allow",
      "ruff *": "allow",
      ".venv/bin/python *": "allow",
      ".venv/bin/python3 *": "allow",
      ".venv/bin/pytest *": "allow",
      ".venv/bin/ruff *": "allow",
      "./.venv/bin/python *": "allow",
      "./.venv/bin/pytest *": "allow",
      "bash scripts/*": "allow",
      "bash ./scripts/*": "allow",
      "./scripts/*": "allow",
      "jq *": "allow",
      "nmap *": "allow",
      "searchsploit *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "pandoc *": "allow",
      "weasyprint *": "allow",
      "pdftotext *": "allow",
      "pdfinfo *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "sudo *": "ask",
      "msfconsole *": "ask",
      "msfvenom *": "ask",
      "hydra *": "ask",
      "sqlmap *": "ask",
      "nikto *": "ask",
      "enum4linux-ng *": "ask",
      "rm *": "ask",
      "kill *": "ask",
      "iptables *": "ask",
      "dd *": "deny",
      "mkfs*": "deny",
      "shutdown *": "deny",
      "reboot *": "deny"
    }
  }
}
